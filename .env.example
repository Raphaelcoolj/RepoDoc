# ── Required ────────────────────────────────────────────────────────────────

# Auth.js v5 (generate: openssl rand -base64 32)
AUTH_SECRET=

# MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/repodoc

# Cloudinary (raw markdown storage)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# AES-256-CBC key for BYOK keys (32-byte hex: openssl rand -hex 32)
ENCRYPTION_KEY=

# ── OAuth providers ─────────────────────────────────────────────────────────
# https://github.com/settings/developers
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# https://console.cloud.google.com/
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# App URL (OAuth callbacks)
NEXTAUTH_URL=http://localhost:3000

# ── GitHub API ──────────────────────────────────────────────────────────────
# Optional but recommended: raises the unauthenticated rate limit (60 → 5000/hr)
GITHUB_TOKEN=

# ── AI provider keys (free tier) ────────────────────────────────────────────
GROQ_API_KEY=
GEMINI_API_KEY=
MISTRAL_API_KEY=
HUGGINGFACE_API_KEY=

# ── AI provider keys (paid / dormant) ───────────────────────────────────────
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
XAI_API_KEY=
GOOGLE_GEMINI_PAID_API_KEY=
GOOGLE_AI_API_KEY=
DEEPSEEK_API_KEY=

# ── Freshness / regeneration tuning (optional) ──────────────────────────────
# Minutes a regeneration lock may be held before it is treated as stuck (default 10)
REGEN_LOCK_TTL_MINUTES=10
# Minimum non-ignored changed files for a push to count as significant (default 3)
REGEN_MIN_SIGNIFICANT_FILES=3
